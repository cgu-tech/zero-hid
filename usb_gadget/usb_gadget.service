[Unit]
Description=USB Gadget (Zero HID Composite)
After=systemd-modules-load.service sysinit.target systemd-udev-settle.service
Wants=systemd-modules-load.service systemd-udev-settle.service

# IMPORTANT: allow recovery loops
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=30

# HARD cleanup (more robust than your current one)
ExecStop=/bin/bash -c '\
G=/sys/kernel/config/usb_gadget/g1; \
if [ -e $G/UDC ]; then echo "" > $G/UDC 2>/dev/null || true; fi; \
sleep 1; \
rm -rf $G 2>/dev/null || true'

ExecStart=/usr/bin/init_usb_gadget

# This is the KEY improvement: safe rebuild path
ExecReload=/bin/bash -c '\
systemctl stop usb_gadget.service; \
sleep 1; \
systemctl start usb_gadget.service'

# Recovery behavior (optional but recommended)
Restart=no

[Install]
WantedBy=multi-user.target