[Unit]
Description=USB Gadget (Zero HID Composite)

# Only ensure kernel + configfs are available
Requires=systemd-modules-load.service systemd-udevd.service
After=systemd-modules-load.service systemd-udevd.service local-fs.target

ConditionPathExists=/sys/kernel/config

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutSec=60

# ONLY synchronization barrier (no teardown logic here)
ExecStartPre=/usr/bin/udevadm settle --timeout=10

# Full lifecycle delegated to script
ExecStart=/usr/bin/init_usb_gadget

# Let script handle cleanup
ExecStop=/usr/bin/init_usb_gadget --stop

# Optional reload = full restart of gadget (script owns logic)
ExecReload=/usr/bin/init_usb_gadget --restart

Restart=no

[Install]
WantedBy=multi-user.target
